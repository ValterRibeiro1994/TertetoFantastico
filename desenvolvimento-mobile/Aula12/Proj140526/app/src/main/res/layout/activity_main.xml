<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginTop="64dp"
        android:text="Faça o cadastro do produto"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txtNome"
        android:layout_width="282dp"
        android:layout_height="55dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="58dp"
        android:ems="10"
        android:hint="Digite  o nome do produto"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <EditText
        android:id="@+id/txtDescricao"
        android:layout_width="285dp"
        android:layout_height="52dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="160dp"
        android:ems="10"
        android:hint="Descreva o produto"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <EditText
        android:id="@+id/txtValor"
        android:layout_width="287dp"
        android:layout_height="52dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="37dp"
        android:ems="10"
        android:hint="Digite o valor do produto "
        android:inputType="number|numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtDescricao" />

    <Button
        android:id="@+id/btnCadastrar"
        android:layout_width="290dp"
        android:layout_height="49dp"
        android:layout_marginStart="80dp"
        android:layout_marginTop="31dp"
        android:text="Cadastrar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtValor" />

    <ListView
        android:id="@+id/ListaProduto"
        android:layout_width="409dp"
        android:layout_height="254dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCadastrar" />

    <Button
        android:id="@+id/btnGestao"
        android:layout_width="297dp"
        android:layout_height="51dp"
        android:layout_marginStart="78dp"
        android:layout_marginTop="6dp"
        android:text="Gestão do orçamento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnCadastrar" />

</androidx.constraintlayout.widget.ConstraintLayout>